{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "TokenStats",
  "version": "0.2.0",
  "identifier": "com.tokenstats.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "TokenStats",
        "url": "/index.html",
        "width": 900,
        "height": 650,
        "minWidth": 700,
        "minHeight": 500,
        "center": true,
        "decorations": true,
        "resizable": true,
        "transparent": false,
        "visible": false,
        "backgroundColor": "#0a0a0c"
      },
      {
        "label": "floating",
        "title": "TokenStats Floating",
        "url": "/floating.html",
        "width": 336,
        "height": 210,
        "x": 100,
        "y": 100,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "transparent": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://trae-api-cn.mchost.guru blob: data:; connect-src 'self' http://127.0.0.1:* https://api.openai.com https://api.anthropic.com; font-src 'self' data:; script-src 'self'"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "id": "main-tray"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns"],
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
